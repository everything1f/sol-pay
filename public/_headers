# Response headers, in the format Netlify, Cloudflare Pages and Cloudflare Workers all read.
# The build copies this file into dist/.

# The page loads its own script and stylesheet, talks to Jupiter, and nothing else.
# Fonts are inlined in the stylesheet, hence font-src data:.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src data:; img-src 'self'; connect-src https://api.jup.ag; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Built files have content-hashed names and never change, so the phone can keep them.
# index.html keeps the host's default (always revalidated), so a new deploy shows at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
